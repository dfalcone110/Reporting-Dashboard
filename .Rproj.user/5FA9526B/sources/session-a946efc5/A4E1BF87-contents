#matchmaker function: analyzes two vector and creates a data frame with two columns. The function will take each instance of x and find instances of y where there are any partial matches. 
# function then creates a two column data frame with each x instance in one column and its corresponding matches in the second column. 

matchmaker <- function(x,y){
  df <- data.frame(chem_name = character(),
                   matches = character())
  for (i in x) {
    assign(paste0("row",i), data.frame(chem_name = i,
                                       matches = toString(y[str_detect(str_to_lower(y), str_to_lower(paste0(i, sep = "")))])))
    df <- df %>%  rbind(get(paste0("row", i)))
  }
  
  print(df)
}

table_binder <- function(x,y){
  matched1 <- matchmaker(x, y) %>% filter(matches != "")%>% separate_rows(matches, sep = ", ")%>% rename(intake_chemicals = "chem_name", HA_Chemicals = "matches")
  
  matched2 <- matchmaker(x, y) %>% filter(matches != "") %>% separate_rows(matches, sep = ", ") %>% rename(HA_Chemicals = "chem_name", intake_chemicals = "matches")
  
  matched <- rbind(matched1, matched2) %>% distinct() %>% select(HA_Chemicals, intake_chemicals)
  
  matched <- merge(matched, ha, by.x = "HA_Chemicals", by.y = "Chemicals" )
}

