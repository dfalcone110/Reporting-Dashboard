table_generator_dbps <- function(x,y,z) {
  
  #variables---------

  variable_assignment(x,y,z)
  
  #generating Data Frame
  df2 <- fn1(z,st, en, si, sc) %>% filter(
    project_no == "THM_HAA Monthly"
  )

  browser()
  df2 <- df2 %>% 
    mutate(
      `Loc/EPID2` = padep_id,
    ) %>% 
    rename(`Loc/EPID`="padep_id", `Samp #` = "lims_number", Contam = "Contam.Code", AnalMeth = "Method.Code"
    ) %>%
    select(PWSID, Transcode, Contam, AnalMeth, Result, AnalDate, `Loc/EPID`, SampDate, SampType, SampTime, LabID, `Sender ID`, `Samp #` , blank1, `Loc/EPID2`, blank2) %>%
    mutate(across(everything(), as.character))
  return(df2) 
}
check_dbps <- table_generator_dbps("December", 2023, "HAAs")