#functions/variables--------------
percentile <- function(x,y,z) {
  liter <- ifelse(z == 1, "1rst Liter", "5th Liter");
  df <- read_LIMS(
    start_date = x,
    end_date = as.Date(x)+years(1),
    project_no = "LCR Compliance"
  ) %>% filter(result_as_entered != "Rejected") %>% 
    mutate(
      result2 = ifelse(grepl("^<",result_as_entered), 0, result),
      sample_class = ifelse(sample_class == "Lead/Copper", "1rst Liter", "5th Liter")
    );
  indexed_df <- df %>% filter(parameter == y,
                              sample_class == liter) %>% 
    arrange(result2) %>% 
    rowid_to_column("index");
  index_num <- round(max(indexed_df$index) * 0.9, digits = 0);
  percentile <- indexed_df %>% filter(indexed_df$index == index_num) %>% 
    select(index, parameter, sample_class, site, result, units);
  print(percentile)
  
}


percentile_df <- function(x,y,z) {
  liter <- ifelse(z == 1, "1rst Liter", "5th Liter");
  df <- read_LIMS(
    start_date = x,
    end_date = as.Date(x)+years(1),
    project_no = "LCR Compliance"
  )%>% filter(result_as_entered != "Rejected")%>% 
    mutate(
      result2 = ifelse(grepl("^<",result_as_entered), 0, result),
      sample_class = ifelse(sample_class == "Lead/Copper", "1rst Liter", "5th Liter")
    );
  indexed_df <- df %>% filter(parameter == y,
                              sample_class == liter) %>% 
    arrange(result2) %>% 
    rowid_to_column("index");
  indexed_df <- indexed_df %>% select(index, parameter, sample_class, site, result_as_entered, units)
  index_num <- round(max(indexed_df$index) * 0.9, digits = 0);
  indexed_df <- DT::datatable(indexed_df, options = list(pageLength = 200))
  
  indexed_df <- if(y == "Lead") {indexed_df%>% formatStyle(
    'result_as_entered',
    target = 'cell',
    backgroundColor = styleInterval(c(.005,.010, .015), c('white', 'yellow', 'orange', 'red'))
  ) %>% formatStyle(
    'index',
    target = 'row',
    backgroundColor = styleEqual(index_num, 'lightgreen')) } else(
      indexed_df %>% formatStyle(
        'result_as_entered',
        target = 'cell',
        backgroundColor = styleInterval(c(1.3), c('white', 'red'))
      ) %>% formatStyle(
        'index',
        target = 'row',
        backgroundColor = styleEqual(index_num, 'lightgreen'))
    )
  
  indexed_df
  
}


